cabal-version: 2.4
name: mp-analytic
version: 0.1.0.0
synopsis: Zeta, primes, Bernoulli numbers, explicit formula
license: AGPL-3.0-or-later
build-type: Simple

library
  exposed-modules: MP.Bernoulli, MP.ExplicitFormula, MP.Primes, MP.Zeta
  build-depends: base >=4.14 && <5
  hs-source-dirs: src
  default-language: Haskell2010

executable mp-analytic
  main-is: Main.hs
  build-depends: base, mp-analytic
  hs-source-dirs: app
  default-language: Haskell2010

test-suite mp-analytic-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  build-depends: base, mp-analytic
  hs-source-dirs: test
  default-language: Haskell2010
