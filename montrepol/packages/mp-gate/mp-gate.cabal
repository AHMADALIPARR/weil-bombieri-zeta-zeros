cabal-version: 2.4
name: mp-gate
version: 0.1.0.0
synopsis: Static scan that no numeric claim is a string literal
license: AGPL-3.0-or-later
build-type: Simple

library
  exposed-modules: MP.Gate.Model, MP.Gate.Render, MP.Gate.Rules, MP.Gate.Scan, MP.Gate.Toml
  build-depends: base >=4.14 && <5
  hs-source-dirs: src
  default-language: Haskell2010

executable mp-gate
  main-is: Main.hs
  build-depends: base, mp-gate
  hs-source-dirs: app
  default-language: Haskell2010
