cabal-version:      3.0
name:               mp-seq
version:            0.1.0.0
synopsis:           Linear recurrences over a field: Berlekamp–Massey and LFSRs.
license:            AGPL-3.0-or-later
build-type:         Simple

library
  exposed-modules:  MP.Recurrence
  hs-source-dirs:   src
  build-depends:    base >=4.20 && <4.21, mp-linalg
  default-language: GHC2021

test-suite mp-seq-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:    base >=4.20 && <4.21, mp-check, mp-linalg, mp-seq
  default-language: GHC2021
